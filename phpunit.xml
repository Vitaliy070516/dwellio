<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force: compose передає APP_ENV/DEMO_MODE/APP_CONFIG_CACHE у контейнер справжніми змінними
             оточення (див. x-app-env), а без force PHPUnit їх не перекриває. Кеш конфігу в тестах —
             неіснуючий файл: інакше під час демо тести взяли б кешовану demo-БД і RefreshDatabase її стер би. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DEMO_MODE" value="false" force="true"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing-never-cached.php" force="true"/>
        <!-- <env force> пише лише $_ENV і putenv, а Laravel (Env) першим читає $_SERVER, куди потрапляє
             справжнє оточення контейнера. Тому ті самі три змінні ще й через <server>. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DEMO_MODE" value="false" force="true"/>
        <server name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing-never-cached.php" force="true"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="AI_EMBEDDING_DRIVER" value="fake"/>
        <env name="AI_LLM_DRIVER" value="fake"/>
        <env name="AI_GENERATION_DRIVER" value="fake"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
