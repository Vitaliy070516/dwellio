APP_NAME=Dwellio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Sail запускає `artisan serve`: без воркерів один повільний запит (холодний старт LLM) блокує весь сайт.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=dwellio
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RABBITMQ_USER=dwellio
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_FAILED_EXCHANGE=dwellio.failed
GRAFANA_PASSWORD=admin
WWWUSER=1000
WWWGROUP=1000

# --- AI: ембединги (див. config/dwellio.php, ADR-004) ---
# fake = детермінований клієнт без мережі ($0). laravel-ai = реальний провайдер.
AI_EMBEDDING_DRIVER=fake
AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_MODEL=bge-m3
# Холодний старт bge-m3 в Ollama ~24 с (завантаження моделі в пам'ять): запас до таймауту 30 с замалий.
AI_EMBEDDING_TIMEOUT=60

# --- AI: чат-модель для парсингу пошукових запитів (Structured Output) ---
AI_LLM_DRIVER=fake
AI_LLM_PROVIDER=ollama
AI_LLM_MODEL=qwen2.5:3b
AI_LLM_TIMEOUT=10

# --- AI: стрімінг тексту для генерації оголошень (День 6) ---
# Таймаут має бути меншим за $timeout Job (240 с), див. config/dwellio.php.
AI_GENERATION_DRIVER=fake
AI_GENERATION_PROVIDER=ollama
AI_GENERATION_MODEL=qwen2.5:3b
AI_GENERATION_TIMEOUT=180
# Ollama у Compose-профілі `ollama` (make up-ollama); ключ не потрібен.
OLLAMA_URL=http://ollama:11434

# --- AI: денні бюджети токенів (День 7, лічильники в Redis, скидання опівночі UTC) ---
# Вичерпано → провайдера не викликаємо: пошук без LLM, генерація 503. Подивитись: make ai-usage
AI_BUDGET_EMBEDDINGS_DAILY=2000000
AI_BUDGET_QUERY_PARSING_DAILY=500000
AI_BUDGET_GENERATION_DAILY=1000000
# Спільна стеля в $ для всіх платних викликів (День 8). Ollama/Fake не рахуються. 0 = заборонити платні виклики.
AI_BUDGET_USD_DAILY=1.00
AI_BUDGET_USD_MONTHLY=10.00
# Rate limit пошуку на IP (кожен некешований запит = LLM + ембединг)
SEARCH_RATE_PER_MINUTE=30

# --- Reverb (WebSockets, див. compose.yaml → reverb) ---
# Локальні значення-заглушки. Для проду згенерувати нові (`artisan reverb:install` або випадкові рядки)
# і тримати в секретах: secret підписує авторизацію приватних каналів.
REVERB_APP_ID=dwellio
REVERB_APP_KEY=dwellio-local-key
REVERB_APP_SECRET=dwellio-local-secret
# Сервер → сервер (воркер/API публікують події): ім'я сервісу в мережі Docker.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Браузер → Reverb: сторінка отримує ці значення в runtime (meta-тег), без перезбірки Vite.
# Порожній host = той самий origin, що й сторінка (тунель / реверс-проксі; на DEMO_MODE — завжди).
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8080
REVERB_CLIENT_SCHEME=http
# Дозволені Origin для WebSocket (кома, шаблони *). Без змінної: '*' локально, '*.trycloudflare.com' на DEMO_MODE.
# REVERB_ALLOWED_ORIGINS=

# --- Публічне демо через Cloudflare Tunnel (День 12): make demo-up / demo-url / demo-down ---
# make demo-up сам ставить DEMO_MODE=true, APP_ENV=production, APP_DEBUG=false (у .env міняти не треба).
# На демо ліміти нижче діють як стеля: береться менше зі звичайного й демо-значення.
DEMO_SEARCH_RATE_PER_MINUTE=10
DEMO_GENERATION_RATE_PER_MINUTE=2
DEMO_GENERATION_RATE_PER_DAY_PER_IP=10
DEMO_GENERATION_RATE_PER_DAY=50
# Скільки хвилин Ollama тримає модель у пам'яті після запиту (за замовчуванням Ollama — 5m).
OLLAMA_KEEP_ALIVE=30m
